{
    "name": "lecturedoc2-author",
    "version": "0.1.0",
    "description": "The LectureDoc2 authoring toolchain: MyST Markdown to LectureDoc2 HTML, PDF rendering, a live-reloading dev server, and manifest-based publishing. The counterpart of `lecturedoc2`, which is the runtime the audience loads.",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/Delors/LectureDoc2Author.git"
    },
    "homepage": "https://github.com/Delors/LectureDoc2Author#readme",
    "author": "Michael Eichberg",
    "license": "BSD-3-Clause",
    "packageManager": "pnpm@11.23.0",
    "type": "module",
    "main": "./src/index.js",
    "exports": {
        ".": "./src/index.js",
        "./plugin": "./myst-plugin.mjs",
        "./pdf": "./src/pdf/render.js",
        "./package.json": "./package.json"
    },
    "bin": {
        "ld2": "./src/cli.js"
    },
    "files": [
        "src",
        "shared/ld",
        "myst-plugin.mjs",
        "README.md",
        "LICENSE.txt"
    ],
    "scripts": {
        "test": "node --test test/*.test.js",
        "fmt": "prettier --write .",
        "fmt:check": "prettier --check ."
    },
    "dependencies": {
        "js-yaml": "^5.2.3",
        "katex": "^0.18.1",
        "mdast-util-to-hast": "^13.2.1",
        "myst-common": "^1.10.0",
        "myst-directives": "^1.7.3",
        "myst-parser": "^1.5.17",
        "myst-roles": "^1.7.3",
        "myst-to-html": "^1.0.9",
        "prismjs": "^1.30.0",
        "rehype-format": "^5.0.1",
        "rehype-stringify": "^10.0.1",
        "unified": "^11.0.5",
        "unist-builder": "^4.0.0",
        "unist-util-visit": "^5.1.0",
        "vfile": "^6.0.3"
    },
    "devDependencies": {
        "prettier": "^3.9.6"
    },
    "engines": {
        "node": ">=22"
    }
}
